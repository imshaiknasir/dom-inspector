{
  "name": "dom-inspector-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Clean-room MV3 element locator inspector",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e && npm run test:mcp",
    "test:unit": "node --test --test-concurrency=1 tests/*.test.js tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "install:browsers": "playwright install chromium",
    "mcp:start": "node mcp/server.js",
    "test:mcp": "node --test --test-concurrency=1 tests/mcp/*.test.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "playwright-core": "^1.48.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  }
}
